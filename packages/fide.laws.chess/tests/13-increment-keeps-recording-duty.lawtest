language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статья 8.4. Осталось 2 минуты, но добавление 30 с за ход — обязанность записи остаётся.
test "urn:query:fide-increment-keeps-recording-duty" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g13"), entity_ref("urn:fide:w13")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g13"), entity_ref("urn:fide:b13")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g13"), entity_ref("urn:fide:w13"), entity_ref("urn:fide:b13")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g13"), entity_ref("urn:fide:b13"), entity_ref("urn:fide:w13")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g13"), entity_ref("urn:fide:w13")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w13")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b13")) { origin case_input; }
        assert "a7": game_in_competition(entity_ref("urn:fide:g13"), entity_ref("urn:fide:c13")) { origin case_input; }
        assert "a8": time_control_base_seconds(entity_ref("urn:fide:c13"), 5400) { origin case_input; }
        assert "a9": time_control_increment_seconds(entity_ref("urn:fide:c13"), 30) { origin case_input; }
        assert "a10": remaining_time_seconds(entity_ref("urn:fide:g13"), entity_ref("urn:fide:w13"), 120.0) { origin case_input; }
    }
    evaluate truth(must_record_moves(entity_ref("urn:fide:g13"), entity_ref("urn:fide:w13")));
    expect truth_status == TRUE_ONLY;
}

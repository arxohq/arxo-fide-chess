language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статья 8.4. Осталось 4 мин 59,5 с, добавление 0: обязанность записи 8.1.1 снята.
test "urn:query:fide-short-of-time-relieves-recording" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g12"), entity_ref("urn:fide:w12")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g12"), entity_ref("urn:fide:b12")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g12"), entity_ref("urn:fide:w12"), entity_ref("urn:fide:b12")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g12"), entity_ref("urn:fide:b12"), entity_ref("urn:fide:w12")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g12"), entity_ref("urn:fide:w12")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w12")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b12")) { origin case_input; }
        assert "a7": game_in_competition(entity_ref("urn:fide:g12"), entity_ref("urn:fide:c12")) { origin case_input; }
        assert "a8": time_control_base_seconds(entity_ref("urn:fide:c12"), 5400) { origin case_input; }
        assert "a9": time_control_increment_seconds(entity_ref("urn:fide:c12"), 0) { origin case_input; }
        assert "a10": remaining_time_seconds(entity_ref("urn:fide:g12"), entity_ref("urn:fide:w12"), 299.5) { origin case_input; }
    }
    evaluate truth(must_record_moves(entity_ref("urn:fide:g12"), entity_ref("urn:fide:w12")));
    expect truth_status == FALSE_ONLY;
}

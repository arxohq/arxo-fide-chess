language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статьи 11.3.2.2 и 12.9. Законы предписали поражение, арбитр вынес предупреждение:
// санкция не соответствует Правилам (пакет не отменяет решение, он называет расхождение).
test "urn:query:fide-warning-instead-of-prescribed-loss" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g16"), entity_ref("urn:fide:w16")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g16"), entity_ref("urn:fide:b16")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g16"), entity_ref("urn:fide:w16"), entity_ref("urn:fide:b16")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g16"), entity_ref("urn:fide:b16"), entity_ref("urn:fide:w16")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g16"), entity_ref("urn:fide:w16")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w16")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b16")) { origin case_input; }
        assert "a7": game_in_competition(entity_ref("urn:fide:g16"), entity_ref("urn:fide:c16")) { origin case_input; }
        assert "a8": time_control_base_seconds(entity_ref("urn:fide:c16"), 5400) { origin case_input; }
        assert "a9": time_control_increment_seconds(entity_ref("urn:fide:c16"), 30) { origin case_input; }
        assert "a10": electronic_device_evident_on_person(entity_ref("urn:fide:g16"), entity_ref("urn:fide:b16")) { origin case_input; }
        assert "a11": penalty_imposed(entity_ref("urn:fide:g16"), entity_ref("urn:fide:b16"), warning) { origin case_input; }
    }
    evaluate truth(penalty_differs_from_prescribed_loss(entity_ref("urn:fide:g16"), entity_ref("urn:fide:b16")));
    expect truth_status == TRUE_ONLY;
}

language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статья 11.3.2.2, последнее предложение. Регламент турнира установил санкцию мягче:
// приоритет §116 снимает поражение.
test "urn:query:fide-event-less-severe-device-penalty" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g15"), entity_ref("urn:fide:w15")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g15"), entity_ref("urn:fide:b15")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g15"), entity_ref("urn:fide:w15"), entity_ref("urn:fide:b15")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g15"), entity_ref("urn:fide:b15"), entity_ref("urn:fide:w15")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g15"), entity_ref("urn:fide:w15")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w15")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b15")) { origin case_input; }
        assert "a7": game_in_competition(entity_ref("urn:fide:g15"), entity_ref("urn:fide:c15")) { origin case_input; }
        assert "a8": time_control_base_seconds(entity_ref("urn:fide:c15"), 5400) { origin case_input; }
        assert "a9": time_control_increment_seconds(entity_ref("urn:fide:c15"), 30) { origin case_input; }
        assert "a10": electronic_device_evident_on_person(entity_ref("urn:fide:g15"), entity_ref("urn:fide:b15")) { origin case_input; }
        assert "a11": event_specifies_less_severe_device_penalty(entity_ref("urn:fide:c15")) { origin case_input; }
    }
    evaluate truth(device_loss_applies(entity_ref("urn:fide:g15"), entity_ref("urn:fide:b15")));
    expect truth_status == FALSE_ONLY;
}

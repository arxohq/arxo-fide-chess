language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

test "observed-possible" {
 given {
  context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
  assert "white": player_of(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:white")) { origin case_input; }
  assert "black": player_of(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin case_input; }
  assert "opponent-w": opponent_of(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:white"),entity_ref("urn:fide:player:black")) { origin case_input; }
  assert "opponent-b": opponent_of(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black"),entity_ref("urn:fide:player:white")) { origin case_input; }
  assert "white-colour": plays_white(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:white")) { origin case_input; }
  assert "side-w": observed_side(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:white"),white_side) { origin case_input; }
  assert "side-b": observed_side(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black"),black_side) { origin case_input; }
  assert "turn": player_has_the_move(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin case_input; }
  assert "count": declared_full_piece_count(entity_ref("urn:fide:podcast:game"),4) { origin case_input; }
  assert "wk": observed_piece(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:wk"),entity_ref("urn:fide:player:white"),King,6,6) { origin case_input; }
  assert "wq": observed_piece(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:wq"),entity_ref("urn:fide:player:white"),Queen,4,7) { origin case_input; }
  assert "bk": observed_piece(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:bk"),entity_ref("urn:fide:player:black"),King,8,8) { origin case_input; }
  assert "br": observed_piece(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:br"),entity_ref("urn:fide:player:black"),Rook,1,1) { origin case_input; }
  assert "flag-observed": flag_fall_observed_by_arbiter(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin case_input; }
  assert "moves-incomplete": prescribed_moves_not_completed(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin case_input; }
  assert "default-assessment": not arbiter_decides_otherwise_on_default(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin adjudicated; }
  assert "refusal-assessment": not persistent_refusal_to_comply(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")) { origin adjudicated; }
  assert "flag-instant": flag_fell_at(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black"),@2026-09-01T11:30:00Z) { origin case_input; }
  assert "roster-wk": board_roster_member(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:wk")) { origin case_input; }
  assert "roster-wq": board_roster_member(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:wq")) { origin case_input; }
  assert "roster-bk": board_roster_member(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:bk")) { origin case_input; }
  assert "roster-br": board_roster_member(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:piece:br")) { origin case_input; }
 }
 evaluate truth(observed_mate_possible(entity_ref("urn:fide:podcast:game"),entity_ref("urn:fide:player:black")));
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
}


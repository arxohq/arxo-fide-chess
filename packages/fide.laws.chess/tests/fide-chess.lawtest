test "FIDE-01-START-ENTERS-PLAYING" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @2023-06-01;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-a0": player_of(entity_ref("urn:entity:fide:game"), entity_ref("urn:entity:fide:white")) {
            origin case_input;
        }

        assert "assert-a1": player_of(entity_ref("urn:entity:fide:game"), entity_ref("urn:entity:fide:black")) {
            origin case_input;
        }

        assert "assert-a2": king_of(entity_ref("urn:entity:fide:white"), entity_ref("urn:entity:fide:white-king")) {
            origin case_input;
        }

        assert "assert-a3": rook_of(entity_ref("urn:entity:fide:white"), entity_ref("urn:entity:fide:white-rook-h")) {
            origin case_input;
        }

        assert "assert-a4": own_piece_of(entity_ref("urn:entity:fide:white"), entity_ref("urn:entity:fide:white-king")) {
            origin case_input;
        }

        assert "assert-a5": own_piece_of(entity_ref("urn:entity:fide:white"), entity_ref("urn:entity:fide:white-rook-h")) {
            origin case_input;
        }

        assert "assert-a6": own_piece_of(entity_ref("urn:entity:fide:white"), entity_ref("urn:entity:fide:white-pawn")) {
            origin case_input;
        }

        assert "assert-a7": checked_game(entity_ref("urn:entity:fide:game")) {
            origin case_input;
        }

        assert "assert-a8": checked_piece(entity_ref("urn:entity:fide:white-king")) {
            origin case_input;
        }

        assert "assert-a9": checked_piece(entity_ref("urn:entity:fide:white-rook-h")) {
            origin case_input;
        }

        assert "assert-a10": checked_piece(entity_ref("urn:entity:fide:white-pawn")) {
            origin case_input;
        }

        assert "assert-a11": checked_player(entity_ref("urn:entity:fide:white")) {
            origin case_input;
        }

        assert "assert-a12": checked_player(entity_ref("urn:entity:fide:black")) {
            origin case_input;
        }

        assert "assert-a13": checked_castling_side(entity_ref("urn:entity:fide:kingside")) {
            origin case_input;
        }

        assert "assert-a14": arbiter_of(entity_ref("urn:entity:fide:game"), entity_ref("urn:entity:fide:arbiter")) {
            origin case_input;
        }

        assert "assert-a15": GamePlay__procedure_instance(entity_ref("urn:entity:fide:game")) {
            origin case_input;
        }

        assert "assert-a16": play_started(entity_ref("urn:entity:fide:game")) {
            origin case_input;
        }

        assert "assert-a17": GamePlay__attempted_transition(entity_ref("urn:entity:fide:game"), StartPlay, GamePlayStep { id: "urn:entity:fide:game#step-0", time: @2023-05-02T09:00:00+05:00 }) {
            origin case_input;
        }
    }

    evaluate truth(GamePlay__entered_state(entity_ref("urn:entity:fide:game"), Playing, GamePlayStep { id: "urn:entity:fide:game#step-0", time: @2023-05-02T09:00:00+05:00 }));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}


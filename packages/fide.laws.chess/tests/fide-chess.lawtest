            origin case_input;
        }

        assert "assert-a10": checked_piece(entity_ref("urn:entity:fide:white-pawn")) {
            origin case_input;
        }

        assert "assert-a11": checked_player(entity_ref("urn:entity:fide:white")) {
            origin case_input;
        }

        assert "assert-a12": checked_player(entity_ref("urn:entity:fide:black")) {
            origin case_input;
        }

        assert "assert-a13": checked_castling_side(entity_ref("urn:entity:fide:kingside")) {
            origin case_input;
        }

        assert "assert-a14": arbiter_of(entity_ref("urn:entity:fide:game"), entity_ref("urn:entity:fide:arbiter")) {
            origin case_input;
        }

        assert "assert-a15": completed_illegal_move_count(entity_ref("urn:entity:fide:white"), 2) {
            origin case_input;
        }

        assert "assert-a16": king_cannot_be_checkmated(entity_ref("urn:entity:fide:white")) {
            origin case_input;
        }
    }

    evaluate truth(game_drawn(entity_ref("urn:entity:fide:game")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(SecondIllegalMoveDrawnIfMateImpossible);
}


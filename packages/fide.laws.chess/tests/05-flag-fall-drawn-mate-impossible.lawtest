language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статья 6.9, второе предложение. Флаг упал, но соперник не может поставить мат: ничья.
test "urn:query:fide-flag-fall-drawn-mate-impossible" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g5"), entity_ref("urn:fide:w5")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g5"), entity_ref("urn:fide:b5")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g5"), entity_ref("urn:fide:w5"), entity_ref("urn:fide:b5")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g5"), entity_ref("urn:fide:b5"), entity_ref("urn:fide:w5")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g5"), entity_ref("urn:fide:w5")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w5")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b5")) { origin case_input; }
        assert "a7": flag_fall_validly_claimed(entity_ref("urn:fide:g5"), entity_ref("urn:fide:w5"), entity_ref("urn:fide:b5")) { origin case_input; }
        assert "a8": prescribed_moves_not_completed(entity_ref("urn:fide:g5"), entity_ref("urn:fide:b5")) { origin case_input; }
        assert "a9": king_cannot_be_checkmated(entity_ref("urn:fide:b5")) { origin case_input; }
    }
    evaluate truth(game_drawn(entity_ref("urn:fide:g5")));
    expect truth_status == TRUE_ONLY;
}

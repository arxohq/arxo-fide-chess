language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Приложение A.4.3 и статья 11.6. В рапиде по соревновательным правилам шестая просьба
// показать бланк — отвлечение соперника и санкция по 12.9.
test "urn:query:fide-excess-scoresheet-requests-penalised" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g24"), entity_ref("urn:fide:w24")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g24"), entity_ref("urn:fide:b24")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g24"), entity_ref("urn:fide:w24"), entity_ref("urn:fide:b24")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g24"), entity_ref("urn:fide:b24"), entity_ref("urn:fide:w24")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g24"), entity_ref("urn:fide:w24")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w24")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b24")) { origin case_input; }
        assert "a7": game_in_competition(entity_ref("urn:fide:g24"), entity_ref("urn:fide:c24")) { origin case_input; }
        assert "a8": time_control_base_seconds(entity_ref("urn:fide:c24"), 900) { origin case_input; }
        assert "a9": time_control_increment_seconds(entity_ref("urn:fide:c24"), 10) { origin case_input; }
        assert "a10": event_regulations_choose_competitive_rules(entity_ref("urn:fide:c24")) { origin case_input; }
        assert "a11": games_supervised_by_one_arbiter(entity_ref("urn:fide:c24"), 3) { origin case_input; }
        assert "a12": each_game_recorded_by_arbiter(entity_ref("urn:fide:c24")) { origin case_input; }
        assert "a13": scoresheet_view_requests(entity_ref("urn:fide:g24"), entity_ref("urn:fide:w24"), 6) { origin case_input; }
    }
    evaluate truth(penalty_under_12_9_due(entity_ref("urn:fide:g24"), entity_ref("urn:fide:w24")));
    expect truth_status == TRUE_ONLY;
}

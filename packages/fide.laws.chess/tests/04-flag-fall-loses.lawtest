language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

// Статья 6.8–6.9. Арбитр видит падение флага, проверка 6.4: ходы не сделаны.
// Мат возможен (closure checked_player) — поражение по времени.
test "urn:query:fide-flag-fall-loses" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "a0": player_of(entity_ref("urn:fide:g4"), entity_ref("urn:fide:w4")) { origin case_input; }
        assert "a1": player_of(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4")) { origin case_input; }
        assert "a2": opponent_of(entity_ref("urn:fide:g4"), entity_ref("urn:fide:w4"), entity_ref("urn:fide:b4")) { origin case_input; }
        assert "a3": opponent_of(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4"), entity_ref("urn:fide:w4")) { origin case_input; }
        assert "a4": plays_white(entity_ref("urn:fide:g4"), entity_ref("urn:fide:w4")) { origin case_input; }
        assert "a5": checked_player(entity_ref("urn:fide:w4")) { origin case_input; }
        assert "a6": checked_player(entity_ref("urn:fide:b4")) { origin case_input; }
        assert "a7": flag_fall_observed_by_arbiter(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4")) { origin case_input; }
        assert "a8": prescribed_moves_not_completed(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4")) { origin case_input; }
        assert "a9": flag_fell_at(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4"), @2026-09-01T11:30:00Z) { origin case_input; }
    }
    evaluate truth(game_lost_by(entity_ref("urn:fide:g4"), entity_ref("urn:fide:b4")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
}

// Статья 8: запись ходов.
//
// Обязанность записи 8.1.1 — побеждаемое правило; её снимают 8.4 (меньше
// пяти минут на часах без добавления 30 секунд и более) и A.2 (рапид и блиц
// по A.5/B.3 — «игроки не обязаны записывать ходы»). Остаток времени — факт
// `Decimal` в секундах на момент, о котором спрашивают (решение 5 шапки):
// пакет не считает, сколько осталось, он применяет порог 8.4 к показанию.
//
// Итог, подписанный обоими (8.7), остаётся в силе даже если неверен, «если
// только арбитр не решит иначе» — канал суждения §47.3.

language "law.core" version "0.2";
package fide.laws.chess version "0.1.1";
namespace "urn:fide:laws:clir:chess";

use self::{
    Competition,
    FIDE_APP_A,
    FIDE_ART_8,
    Game,
    Player,
    appendix_a5_applies,
    game_in_competition,
    player_of,
    time_control_increment_seconds,
};

pub relation remaining_time_seconds(game: Game, who: Player, secs: Decimal) kind empirical {
    label en official "the time left on the player's clock during the allotted period, in seconds";
}
relation moves_recorded_in_advance(game: Game, who: Player) kind empirical {
    label en official "the player recorded moves in advance";
}
relation claiming_draw_or_adjourning(game: Game, who: Player) kind empirical {
    label en official "the player is claiming a draw under Article 9.2 or 9.3 or adjourning the game";
}
relation result_signed_by_both(game: Game) kind empirical {
    label en official "both players indicated the result of the game by signing both scoresheets or approving it on electronic scoresheets";
}

external judgment relation arbiter_decides_otherwise_on_signed_result(game: Game) {
    authority FIDEArbiter;
    label en official "the arbiter decides otherwise on the result indicated by the players";
}

pub relation must_record_moves(game: Game, who: Player) kind institutional {
    label en official "the player is required to record his/her own moves and those of the opponent";
}
relation recording_in_advance_forbidden_breached(game: Game, who: Player) kind institutional {
    label en official "the player recorded moves in advance, which is forbidden";
}
relation signed_result_stands(game: Game) kind institutional {
    label en official "the result indicated by the players shall stand";
}

@source(FIDE_ART_8)
rule EachPlayerMustRecord(game: Game, who: Player) defeasible {
    label en official "Article 8.1.1. In the course of play each player is required to record his/her own moves and those of his/her opponent";
    when player_of(game, who);
    then must_record_moves(game, who);
}

@source(FIDE_ART_8)
rule ShortOfTimeRelievesRecording(game: Game, who: Player, comp: Competition, secs: Decimal, inc: Integer) defeasible {
    label en official "Article 8.4. A player with less than five minutes left and without an increment of 30 seconds or more is not obliged to meet the requirements of Article 8.1.1";
    when player_of(game, who)
        and remaining_time_seconds(game, who, secs)
        and (secs < 300.0)
        and game_in_competition(game, comp)
        and time_control_increment_seconds(comp, inc)
        and (inc < 30);
    then not must_record_moves(game, who);
}

@source(FIDE_ART_8)
priority ShortOfTimeOverRecordingDuty {
    label en official "Article 8.4. The relief for a player short of time prevails over the duty to record";
    prefer ShortOfTimeRelievesRecording over EachPlayerMustRecord;
    reason lex_specialis;
}

@source(FIDE_APP_A)
rule RapidPlayersNeedNotRecord(game: Game, who: Player) defeasible {
    label en official "Article A.2. Players do not need to record the moves";
    when player_of(game, who)
        and appendix_a5_applies(game);
    then not must_record_moves(game, who);
}

@source(FIDE_APP_A)
priority RapidReliefOverRecordingDuty {
    label en official "Article A.2. In rapid and blitz governed by Article A.5 players need not record the moves";
    prefer RapidPlayersNeedNotRecord over EachPlayerMustRecord;
    reason lex_specialis;
}

@source(FIDE_ART_8)
rule RecordingInAdvanceForbidden(game: Game, who: Player) defeasible {
    label en official "Article 8.1.2. It is forbidden to record the moves in advance";
    when moves_recorded_in_advance(game, who);
    then recording_in_advance_forbidden_breached(game, who);
}

@source(FIDE_ART_8)
rule AdvanceRecordingAllowedForDrawClaim(game: Game, who: Player) defeasible {
    label en official "Article 8.1.2. Unless the player is claiming a draw according to Article 9.2 or 9.3 or adjourning a game";
    when moves_recorded_in_advance(game, who)
        and claiming_draw_or_adjourning(game, who);
    then not recording_in_advance_forbidden_breached(game, who);
}

@source(FIDE_ART_8)
priority DrawClaimRecordingException {
    label en official "Article 8.1.2. Recording a move for a draw claim or adjournment is not a forbidden advance recording";
    prefer AdvanceRecordingAllowedForDrawClaim over RecordingInAdvanceForbidden;
    reason lex_specialis;
}

@source(FIDE_ART_8)
rule SignedResultStands(game: Game) strict {
    label en official "Article 8.7. Even if incorrect, the result indicated by both players shall stand, unless the arbiter decides otherwise";
    when result_signed_by_both(game)
        and not arbiter_decides_otherwise_on_signed_result(game);
    then signed_result_stands(game);
}

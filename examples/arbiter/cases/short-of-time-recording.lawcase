language "law.core" version "0.2";
package examples.chess.arbiter version "0.1.0";
namespace "urn:law:examples:chess:arbiter";

// Статья 8.4: классика 90 минут без добавления, у белых 4 минуты на часах —
// обязанность записи 8.1.1 снята до конца периода.
case ShortOfTimeRecording {
    context { legal_time @2026-09-01; knowledge_time @2026-09-08T12:00:00Z; decision_time @2026-09-08T12:00:00Z; timezone "UTC"; }
    assert "white": fide.laws.chess::player_of(entity_ref("urn:example:chess:game"), entity_ref("urn:example:chess:white")) { origin case_input; }
    assert "competition": fide.laws.chess::game_in_competition(entity_ref("urn:example:chess:game"), entity_ref("urn:example:chess:classic")) { origin case_input; }
    assert "base": fide.laws.chess::time_control_base_seconds(entity_ref("urn:example:chess:classic"), 5400) { origin case_input; }
    assert "increment": fide.laws.chess::time_control_increment_seconds(entity_ref("urn:example:chess:classic"), 0) { origin case_input; }
    assert "clock": fide.laws.chess::remaining_time_seconds(entity_ref("urn:example:chess:game"), entity_ref("urn:example:chess:white"), 240.0) { origin case_input; }
}

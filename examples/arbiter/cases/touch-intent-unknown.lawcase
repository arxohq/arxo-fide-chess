language "law.core" version "0.2";
package examples.chess.arbiter version "0.1.0";
namespace "urn:law:examples:chess:arbiter";

// Фигура своя и может ходить; намеренное касание требует суждения арбитра.
case TouchIntentUnknown {
    context { legal_time @2023-06-01; knowledge_time @2026-09-08T12:00:00Z; decision_time @2026-09-08T12:00:00Z; timezone "UTC"; }
    assert "player": fide.laws.chess::player_of(entity_ref("urn:example:chess:game"), entity_ref("urn:example:chess:white")) { origin case_input; }
    assert "turn": fide.laws.chess::player_has_the_move(entity_ref("urn:example:chess:game"), entity_ref("urn:example:chess:white")) { origin case_input; }
    assert "own": fide.laws.chess::own_piece_of(entity_ref("urn:example:chess:white"), entity_ref("urn:example:chess:king")) { origin case_input; }
    assert "movable": fide.laws.chess::piece_can_be_moved(entity_ref("urn:example:chess:king")) { origin case_input; }

}
